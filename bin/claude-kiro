#!/usr/bin/env sh

set -eu

SELF_PATH="$0"
while [ -h "${SELF_PATH}" ]; do
  SELF_DIR="$(CDPATH= cd -- "$(dirname -- "${SELF_PATH}")" && pwd)"
  LINK_TARGET="$(readlink "${SELF_PATH}")"
  case "${LINK_TARGET}" in
    /*) SELF_PATH="${LINK_TARGET}" ;;
    *) SELF_PATH="${SELF_DIR}/${LINK_TARGET}" ;;
  esac
done
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "${SELF_PATH}")" && pwd)"

stop_managed_gateway() {
  if [ "${CLAUDE_KIRO_STARTED_GATEWAY:-0}" -eq 1 ] && [ -n "${CLAUDE_KIRO_GATEWAY_PID:-}" ]; then
    kill "${CLAUDE_KIRO_GATEWAY_PID}" >/dev/null 2>&1 || true
    wait "${CLAUDE_KIRO_GATEWAY_PID}" 2>/dev/null || true
  fi
}

. "${SCRIPT_DIR}/_kiro_gateway_common.sh"

kiro_gateway_init_env "$0"
require_command curl
require_command claude

# ---------------------------------------------------------------------------
# Detect conflicting ANTHROPIC_BASE_URL in Claude Code settings.json
# cc-switch (or similar tools) may write env overrides that take precedence
# over the environment variables exported by this script.
# ---------------------------------------------------------------------------
CLAUDE_SETTINGS_FILE="${HOME}/.claude/settings.json"
if [ -f "${CLAUDE_SETTINGS_FILE}" ]; then
  # Extract ANTHROPIC_BASE_URL value from settings.json (lightweight, no jq needed)
  settings_base_url="$(
    sed -n 's/.*"ANTHROPIC_BASE_URL"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
      "${CLAUDE_SETTINGS_FILE}" | head -n 1
  )"

  if [ -n "${settings_base_url}" ] && [ "${settings_base_url}" != "${ANTHROPIC_BASE_URL}" ]; then
    print_error ""
    print_error "⚠️  检测到代理冲突！"
    print_error ""
    print_error "   settings.json 中:  ANTHROPIC_BASE_URL = ${settings_base_url}"
    print_error "   claude-kiro 需要:  ANTHROPIC_BASE_URL = ${ANTHROPIC_BASE_URL}"
    print_error ""
    print_error "   Claude Code 会优先使用 ~/.claude/settings.json 中的 env 配置，"
    print_error "   导致请求被转发到其他代理，kiro-gateway 无法收到任何请求。"
    print_error ""
    print_error "   请先关闭冲突的代理（如 cc-switch off），或手动删除"
    print_error "   ~/.claude/settings.json 中的 ANTHROPIC_BASE_URL 配置项。"
    exit 1
  fi
fi

CLAUDE_KIRO_STARTED_GATEWAY=0
CLAUDE_KIRO_GATEWAY_PID=""

if ! gateway_is_healthy; then
  print_error "Starting Kiro Gateway on ${ANTHROPIC_BASE_URL} ..."
  CLAUDE_KIRO_GATEWAY_PID="$(start_gateway_process)"
  CLAUDE_KIRO_STARTED_GATEWAY=1
  export CLAUDE_KIRO_GATEWAY_PID
  export CLAUDE_KIRO_STARTED_GATEWAY
  trap stop_managed_gateway EXIT INT TERM

  if ! wait_for_gateway; then
    print_error "Kiro Gateway failed to become healthy."
    print_error "Log: ${KIRO_GATEWAY_LOG_FILE}"
    if [ -f "${KIRO_GATEWAY_LOG_FILE}" ]; then
      tail -n 40 "${KIRO_GATEWAY_LOG_FILE}" >&2 || true
    fi
    exit 1
  fi

  print_error "Kiro Gateway is ready."
fi

set +e
"$(command -v claude)" "$@"
CLAUDE_EXIT_CODE=$?
set -e

exit "${CLAUDE_EXIT_CODE}"
